# ---------------------------------------------------------------------------
# 站台位址
# ---------------------------------------------------------------------------
# 正式網域，結尾不要加斜線。
# Google OAuth 的 redirect_uri、通知信裡的驗證連結與 QR Code 都由這個值推導，
# 必須與 Google Cloud Console 上登記的「已授權的重新導向 URI」完全一致。
APP_URL=https://gdg.ncuesa.org.tw

# ---------------------------------------------------------------------------
# Google OAuth 2.0（Web application 類型的用戶端）
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# 簽發後台 session cookie 與證書防竄改簽章的金鑰。
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 換掉這個值會讓所有人被登出，且既有證書的簽章驗證會失敗，正式上線後請勿更動。
AUTH_SECRET=

# 允許進入後台的 Google 帳號（逗號分隔）
ADMIN_EMAILS=someone@gmail.com,another@ncuesa.org.tw
# 選填：整個網域都放行（逗號分隔，不含 @）
# ADMIN_EMAIL_DOMAINS=ncuesa.org.tw

# ---------------------------------------------------------------------------
# 資料存放位置（SQLite 資料庫與證書圖片）
# ---------------------------------------------------------------------------
# 本機開發預設 ./data；Zeabur 上要指到掛載 Volume 的路徑。
DATA_DIR=./data

# ---------------------------------------------------------------------------
# 郵件（Gmail SMTP）
# ---------------------------------------------------------------------------
# Gmail 帳號與應用程式密碼（需開啟兩步驟驗證後申請）
SMTP_USER=ideasspr@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# 選填：信件中「聯絡我們」的收件地址
# MAIL_CONTACT=gdg-core@gmail.com

